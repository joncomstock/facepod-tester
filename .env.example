# FacePod tester — backend environment.
# Copy to `.env` and adjust. Do NOT commit `.env` (see .gitignore).
# The backend reads these on startup; the UI can override the FFI knobs and mock
# mode per-connect (panel 01).

# The live transport is USB over Deno FFI (native HidFace.dll); run with
# `--allow-ffi` (the `dev` task includes it). The library finds the DLL via its
# own resolution by default — set the vars below only to point at a specific
# install. FACEPOD_* is the tester convention; HIDFACE_* is honored as a
# fallback (FACEPOD_* wins when both are set).

# Path to HidFace.dll (else the library uses HIDFACE_DLL_PATH, then PATH).
# FACEPOD_DLL_PATH=C:\hid\HidFace.dll

# Search dir for co-located deps (ICypher.dll, VC runtime); defaults to the
# DLL's own directory.
# FACEPOD_DLL_DIR=C:\hid

# Poll interval (ms) while awaiting an async native operation (default 33).
# FACEPOD_POLL_INTERVAL_MS=33

# Mock mode: serve a deterministic fake device so the UI works without hardware.
# Set to true to exercise the full workflow offline (no --allow-ffi needed).
FACEPOD_MOCK=false

# Initial mock scenario preset (only used when FACEPOD_MOCK=true). One of:
#   good | low-quality | spoof | no-face | no-match | device-error
# Switchable live from the UI (no reconnect) via the "Mock scenario" selector.
FACEPOD_MOCK_SCENARIO=good

# Backend HTTP port (the Vite dev server proxies /api here).
PORT=8787
